{
  "name": "fishingextension",
  "version": "0.1.0",
  "description": "A Firefox toolbar popup for recent and upcoming California fish stocking information.",
  "scripts": {
    "test": "node --test",
    "lint:extension": "web-ext lint",
    "build:extension": "web-ext build --overwrite-dest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EnRangel/fishingExtension.git"
  },
  "keywords": [],
  "author": "EnRangel",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/EnRangel/fishingExtension/issues"
  },
  "homepage": "https://github.com/EnRangel/fishingExtension#readme",
  "webExt": {
    "sourceDir": ".",
    "artifactsDir": "web-ext-artifacts",
    "ignoreFiles": [
      "docs",
      "docs/**",
      "test",
      "test/**",
      "vendor",
      "vendor/**",
      "node_modules/**",
      "web-ext-artifacts/**",
      "package.json",
      "package-lock.json",
      "README.md",
      ".gitignore"
    ]
  },
  "devDependencies": {
    "web-ext": "^10.8.0"
  }
}
