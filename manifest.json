{
  "manifest_version": 3,
  "name": "California Fish Stocking",
  "version": "0.1.0",
  "description": "Shows recent and upcoming California fish stockings.",
  "browser_specific_settings": {
    "gecko": {
      "id": "california-fish-stocking@enrangel",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://services2.arcgis.com/*",
    "https://www.nrm.dfg.ca.gov/*"
  ],
  "action": {
    "default_title": "View California fish stockings",
    "default_popup": "src/popup/index.html"
  }
}
